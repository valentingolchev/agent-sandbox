# agent-sandbox machine defaults.
# Created by setup.sh from config.template. Edit freely — this file is
# yours, not managed by the repo. Re-run setup.sh to reset to defaults.
#
# Global keys below. [path] sections override them for workspaces under
# that path (longest matching prefix wins; ~ expands to $HOME).

stack = base
harness = manual

# Container runtime: podman (default on Linux) or docker.
# Auto-detected if unset. Set CONTAINER_RUNTIME env var to override.
# On macOS, use docker (Docker Desktop). On Linux, podman is preferred
# (rootless, no daemon); docker works if the daemon is running.
# runtime = podman

memory = 8g
cpus = 4

no_network = false
persist_caches = false

# Harness state snapshot: host state is copied to a snapshot, agent works on
# the snapshot. Host state is NEVER modified. Chat history stays in snapshot.
# Default: false (secure by default — no host state shared unless enabled).
# Set to true to enable state sharing (agent can use your existing logins,
# agents, skills, commands).
# harness_state_action: prompt (ask each time) | keep (sync configs from host)
#                       | reset (fresh from host) | discard (empty)
harness_state = false
harness_state_action = prompt

# Extra env var names passed into the container, on top of the common AI
# provider keys (ANTHROPIC_API_KEY, OPENAI_API_KEY, MISTRAL_API_KEY, ...)
# that are always forwarded when set, e.g.
# env_keys = MY_CUSTOM_KEY
env_keys =

# Session audit log: append metadata (date, workspace, image, harness) to this
# file on each run. Useful for tracking what the agent accessed.
# session_log = ~/.local/share/agent-sandbox/audit.log

# Per-project override: the agent-sandbox repo itself.
# This section was generated by setup.sh — @SANDBOX_ROOT@ is replaced
# with the actual repo path on your machine.
[@SANDBOX_ROOT@]
stack = base
harness = opencode

