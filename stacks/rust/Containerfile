# Rust stack: base + rustup-managed toolchain installed system-wide under /opt.
# The rustup proxies (cargo/rustc) are installed into /opt/cargo/bin with the
# build-time CARGO_HOME; the runtime CARGO_HOME below then redirects
# downloads/registry to the agent home (runtime tmpfs, or a persistent volume
# with PERSIST_CACHES=1) so the read-only image layer stays pristine.
# Build:  podman build -t agent-sandbox:rust-<harness> .
ARG BASE_IMAGE=agent-sandbox:base-tools
FROM ${BASE_IMAGE}
USER root

ENV RUSTUP_HOME=/opt/rustup \
    CARGO_HOME=/opt/cargo

# rustup installer + toolchain pinned: 1.29.0 (update deliberately)
RUN curl -fsSL -o /tmp/rustup-init.sh https://sh.rustup.rs && \
    sh /tmp/rustup-init.sh -y --no-modify-path --profile minimal \
        --default-toolchain 1.91.0 && \
    rm -f /tmp/rustup-init.sh && \
    chmod -R a+rX /opt/rustup /opt/cargo

ENV CARGO_HOME=/home/agent/.cargo \
    PATH=/opt/cargo/bin:$PATH

USER agent
CMD ["/bin/bash"]
