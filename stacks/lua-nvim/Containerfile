# Lua/Neovim plugin development stack: Neovim, Lua/LuaJIT, LuaRocks and
# native build tooling for compiling rockspec C modules and treesitter
# parsers.
# Build:  podman build -t agent-sandbox:lua-nvim-<harness> .
ARG BASE_IMAGE=agent-sandbox:base-tools
FROM ${BASE_IMAGE}
USER root

RUN microdnf --setopt=install_weak_deps=False --setopt=tsflags=nodocs install -y \
        neovim lua luajit luarocks \
        lua-devel luajit-devel \
        gcc make && \
    microdnf clean all

USER agent
CMD ["/bin/bash"]
