# Node stack: base (which already ships nodejs, npm and the harness CLIs)
# plus pnpm.
# Build:  podman build -t agent-sandbox:node-<harness> .
ARG BASE_IMAGE=agent-sandbox:base-tools
FROM ${BASE_IMAGE}
USER root

RUN npm install -g pnpm && \
    npm cache clean --force && \
    chown -R agent:agent /home/agent

USER agent
CMD ["/bin/bash"]
