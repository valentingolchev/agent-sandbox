# Web front-end stack for React + ClojureScript: clojure stack + pnpm for
# shadow-cljs / nbb / JS toolchains (nodejs and npm come from the base).
# Build:  podman build --build-arg BASE_IMAGE=agent-sandbox:clojure-<harness> -t agent-sandbox:web-cljs-<harness> .
# (BASE_IMAGE is always set by the build system; default is a safe fallback)
ARG BASE_IMAGE=agent-sandbox:base-tools
FROM ${BASE_IMAGE}
USER root

RUN npm install -g pnpm && \
    npm cache clean --force && \
    chown -R agent:agent /home/agent

USER agent
CMD ["/bin/bash"]
