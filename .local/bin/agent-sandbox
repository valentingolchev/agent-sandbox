#!/usr/bin/env bash
# agent-sandbox: run an LLM coding agent inside a hardened container.
# Works with podman (rootless, Linux) or docker (Linux daemon, macOS Desktop).
#
# Usage (from a project root):
#   agent-sandbox [workspace-dir]
#
# The workspace is mounted at /workspace/<name> inside the container (not the
# host path) to avoid leaking the host's directory structure to the agent.
#
# Prompts for the stack image and the harness to launch. Env vars skip a
# prompt; the config file preselects its default answer.
# Precedence: env var > config file > prompt.
#
# Config: ~/.config/agent-sandbox/config ("key = value", [path] sections for
# per-project overrides). Logic lives in lib/ beside this script:
#   common.sh       helpers (trim, bools, die)
#   config.sh       config file parsing
#   runtime.sh      container runtime detection (podman/docker)
#   stacks.sh       stack auto-discovery + image builds
#   prompts.sh      interactive pickers
#   credentials.sh  env var / keyring propagation (active harness only)
#   state.sh        harness state snapshot management
#
# Env vars:
#   CONTAINER_RUNTIME  podman | docker        (overrides auto-detection)
#   AGENT_IMAGE    stack tag, e.g. agent-sandbox:elixir or agent-sandbox:elixir-claude
#                  (harness suffix optional, stripped if present)
#   HARNESS        claude | opencode | vibe | pi | manual  (skips prompt)
#   REBUILD=1      rebuild the image chain first
#   NO_NETWORK=1   no networking at all
#   PERSIST_CACHES=1   keep tool caches across runs (named volumes)
#   HARNESS_STATE=1    enable harness state snapshot (default: disabled)
#   HARNESS_STATE_ACTION=keep|reset|discard|prompt   snapshot action (default: prompt)
#   MEMORY, CPUS   resource limits (default 8g / 4)
#   ENV_KEYS       extra env var names to pass into the container
#   SESSION_LOG    append session metadata to this file (audit log)
#   AGENT_SANDBOX_CONFIG   alternative config file path
set -euo pipefail

# Follow the ~/.local/bin symlink back to the repo (libs + build contexts).
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
SANDBOX_ROOT="$(cd "$(dirname "$SELF")/../.." && pwd)"

# Parse flags
CHECK_ONLY=0
ARGS=()
for arg in "$@"; do
    case "$arg" in
        --check|--validate) CHECK_ONLY=1 ;;
        *) ARGS+=("$arg") ;;
    esac
done
set -- "${ARGS[@]}"

WORKSPACE_DIR="$(realpath "${1:-$PWD}")"
WORKSPACE_NAME="$(basename "$WORKSPACE_DIR")"

source "$SANDBOX_ROOT/lib/common.sh"
source "$SANDBOX_ROOT/lib/config.sh"
source "$SANDBOX_ROOT/lib/runtime.sh"
source "$SANDBOX_ROOT/lib/stacks.sh"
source "$SANDBOX_ROOT/lib/prompts.sh"
source "$SANDBOX_ROOT/lib/credentials.sh"
source "$SANDBOX_ROOT/lib/state.sh"
source "$SANDBOX_ROOT/lib/validate.sh"

# P1: Scan workspace for potential secrets before running the container.
scan_workspace_secrets() {
    local secrets
    secrets=$(find "$WORKSPACE_DIR" -maxdepth 2 \
        \( -name '.env' -o -name '*.pem' -o -name '*.key' \
           -o -name 'credentials*' -o -name 'secrets*' -o -name '*.p12' \
           -o -name 'id_rsa*' -o -name 'id_ed25519*' \) \
        -not -path '*/.git/*' 2>/dev/null)
    if [ -n "$secrets" ]; then
        echo "⚠️  Warning: Potential secrets found in workspace:" >&2
        echo "$secrets" | sed "s|^$WORKSPACE_DIR/|     |" >&2
        echo "   The agent will have read access to these files." >&2
        echo >&2
    fi
}

load_config

# --check: validate config and exit
if [ "$CHECK_ONLY" -eq 1 ]; then
    validate_config "$CONFIG_FILE"
    exit $?
fi

detect_runtime
check_runtime

echo "Using container runtime: $RUNTIME" >&2

# P1: Warn about Docker on Linux (root daemon risk)
if [ "$RUNTIME" = "docker" ] && [ "$(uname -s)" = "Linux" ]; then
    echo "⚠️  Warning: Using Docker on Linux. Docker daemon runs as root." >&2
    echo "   Container escape = root on host. Prefer podman (rootless):" >&2
    echo "   sudo dnf install podman  # or apt/pacman" >&2
    echo >&2
fi

validate_bool "NO_NETWORK" "${NO_NETWORK:-${CONFIG[no_network]:-}}"
validate_bool "PERSIST_CACHES" "${PERSIST_CACHES:-${CONFIG[persist_caches]:-}}"
validate_bool "HARNESS_STATE" "${HARNESS_STATE:-${CONFIG[harness_state]:-}}"

# Pick stack and harness before the (potentially slow) first build.
stack_name="$(choose_stack)"
HARNESS_NAME="$(choose_harness)"
HARNESS_CMD="$(resolve_harness "$HARNESS_NAME")"
IMAGE="$(image_name_for "$stack_name" "$HARNESS_NAME")"

echo "Image: $IMAGE   Workspace: $WORKSPACE_DIR" >&2

ensure_image "$stack_name" "$HARNESS_NAME"

# ---- init script (runs inside container before harness) ----
INIT_ARGS=()
HARNESS_ARGS=("$HARNESS_CMD")
if [ -n "${CONFIG[init_script]:-}" ]; then
    INIT_SCRIPT="${CONFIG[init_script]}"
    INIT_SCRIPT="${INIT_SCRIPT/#\~/$HOME}"
    if [ ! -f "$INIT_SCRIPT" ]; then
        die "init_script not found: $INIT_SCRIPT"
    fi
    INIT_ARGS=(-v "$INIT_SCRIPT:/init.sh:ro")
    HARNESS_ARGS=(/bin/bash -c "/init.sh && exec $HARNESS_CMD")
fi

# ---- container args ----

# Runtime-specific user mapping (userns=keep-id for podman, --user for docker).
mapfile -t USER_ARGS < <(user_args)

# SELinux label disable on SELinux-enabled Linux hosts.
mapfile -t SECURITY_OPTS < <(security_opts)

# Network: podman rootless and docker both isolate userland networking;
# --dns avoids using the host's resolver. No DNS flags with --network none.
if is_true "${NO_NETWORK:-${CONFIG[no_network]:-}}"; then
    NET_ARGS=(--network none)
else
    NET_ARGS=(--dns 1.1.1.1 --dns-search .)
    # P1: Network warning banner
    echo "⚠️  Network access enabled — agent can reach the internet" >&2
    echo "   Use NO_NETWORK=1 to disable (may break AI API calls)" >&2
    echo >&2
fi

build_env_args
retrieve_keyring_secrets

# Opt-in persistent tool caches: faster repeat sessions, at the cost of
# state surviving across runs.
CACHE_ARGS=()
if is_true "${PERSIST_CACHES:-${CONFIG[persist_caches]:-}}"; then
    CACHE_ARGS+=(
        -v agent-local:/home/agent/.local/share/mise
        -v agent-npm:/home/agent/.npm
        -v agent-pip:/home/agent/.cache/pip
        -v agent-uv:/home/agent/.cache/uv
        -v agent-cargo:/home/agent/.cargo
        -v agent-luarocks:/home/agent/.luarocks
        -v agent-elixir:/home/agent/.mix
        -v agent-hex:/home/agent/.hex
        -v agent-m2:/home/agent/.m2
    )
fi

# Harness state snapshot: copy-on-write with host-wins config sync.
#   - Host state is NEVER modified (no sync-back)
#   - Snapshot accumulates chat history, session data across runs
#   - On [K]eep: host configs overwrite snapshot configs (host wins)
#   - On [R]eset: wipe snapshot, copy fresh configs from host
#   - On [D]iscard: wipe snapshot, start empty
# Action: HARNESS_STATE_ACTION=keep|reset|discard|prompt (default: prompt)
STATE_ARGS=()
if is_true "${HARNESS_STATE:-${CONFIG[harness_state]:-false}}"; then
    SNAPSHOT_DIR="$HOME/.local/share/agent-sandbox/state/$HARNESS_NAME"
    STATE_ACTION="${HARNESS_STATE_ACTION:-${CONFIG[harness_state_action]:-prompt}}"
    setup_harness_state "$HARNESS_NAME" "$SNAPSHOT_DIR" "$STATE_ACTION"
fi

# -it needs a TTY on both ends; scripted runs fall back to -i.
TTY_ARGS=(-i)
[[ -t 0 && -t 1 ]] && TTY_ARGS=(-it)

# Keyring secret goes in via --env-file (never on the command line).
ENV_FILE_ARGS=()
if [ -n "$KEYRING_ENV_FILE" ]; then
    ENV_FILE_ARGS=(--env-file "$KEYRING_ENV_FILE")
fi

# P1: Scan workspace for potential secrets
scan_workspace_secrets

# P1: Session audit log — record what was run (not full session output)
SESSION_LOG_FILE="${SESSION_LOG:-${CONFIG[session_log]:-}}"
if [ -n "$SESSION_LOG_FILE" ]; then
    mkdir -p "$(dirname "$SESSION_LOG_FILE")"
    {
        echo "=== agent-sandbox session ==="
        echo "Date:      $(date '+%Y-%m-%d %H:%M:%S')"
        echo "User:      $(whoami)"
        echo "Workspace: $WORKSPACE_DIR"
        echo "Image:     $IMAGE"
        echo "Harness:   $HARNESS_NAME"
        echo "Runtime:   $RUNTIME"
        echo "Network:   $(is_true "${NO_NETWORK:-${CONFIG[no_network]:-}}" && echo 'disabled' || echo 'enabled')"
        echo "State:     $(is_true "${HARNESS_STATE:-${CONFIG[harness_state]:-false}}" && echo 'enabled' || echo 'disabled')"
        echo "==============================="
        echo
    } >> "$SESSION_LOG_FILE"
fi

# ---- run ----

trap '[ -z "$KEYRING_ENV_FILE" ] || rm -f "$KEYRING_ENV_FILE"' EXIT

"$RUNTIME" run "${TTY_ARGS[@]}" --rm \
    --pull=never \
    --name "agent-sandbox-$$" \
    "${USER_ARGS[@]}" \
    --init \
    --no-hosts \
    --read-only \
    --tmpfs /tmp:rw,size=2g \
    --tmpfs /home/agent:rw,size=1g,mode=1777 \
    --cap-drop=ALL \
    --security-opt no-new-privileges \
    "${SECURITY_OPTS[@]}" \
    --pids-limit 512 \
    --memory "${MEMORY:-${CONFIG[memory]:-8g}}" \
    --cpus "${CPUS:-${CONFIG[cpus]:-4}}" \
    "${NET_ARGS[@]}" \
    "${ENV_ARGS[@]}" \
    "${CACHE_ARGS[@]}" \
    "${STATE_ARGS[@]}" \
    "${ENV_FILE_ARGS[@]}" \
    "${INIT_ARGS[@]}" \
    -v "$WORKSPACE_DIR:/workspace/$WORKSPACE_NAME:rw" \
    -w "/workspace/$WORKSPACE_NAME" \
    "$IMAGE" \
    "${HARNESS_ARGS[@]}"
